# Production Configuration for VPS

# Database Connection (Points to SQL Server running on the host VPS)
# Use host.docker.internal to connect to SQL Server on the VPS host
CONNECTION_STRING=Server=host.docker.internal,1433;Database=ClinicaDb;User Id=sa;Password=TuPasswordSeguroAqui!;TrustServerCertificate=True;

# Public API URL (URL or IP of your VPS accessible from browsers)
# Example with IP: http://192.168.1.100:5011
# Example with domain: https://api.tu-clinica.com
NEXT_PUBLIC_API_URL=http://localhost:5011

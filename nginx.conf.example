# Configuración de Nginx para VPS (IP: 157.173.99.216)
# Archivo en VPS: /etc/nginx/conf.d/clinica.conf (o /etc/nginx/sites-available/clinica)

# Frontend Web
server {
    listen 8084;
    server_name 157.173.99.216;

    location / {
        proxy_pass http://clinica-web:3000;

        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

# API Backend
server {
    listen 5011;
    server_name 157.173.99.216;

    location / {
        proxy_pass http://clinica-api:8080;

        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
